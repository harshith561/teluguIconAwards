# Server Port (default 3001)
PORT=3001

# High-traffic tuning
CLUSTER=0
WORKERS=1
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=50000

# Set to true ONLY when running behind nginx / Cloudflare / Railway / a load
# balancer that sets X-Forwarded-For. Required in production, otherwise every
# visitor is seen as one shared IP: the per-IP vote limit and the
# (ip_address, user_agent) duplicate guard would then lock out the whole site.
# TRUST_PROXY=true

# Per-IP vote ceiling (flood protection only - the votes table unique keys are
# the authoritative one-vote-per-person-per-category limit).
VOTE_RATE_MAX=20
VOTE_RATE_WINDOW_MINUTES=60

# ---------------------------------------------------------------------------
# MySQL (XAMPP) connection
# ---------------------------------------------------------------------------
# XAMPP ships with user `root` and an empty password.
# The default port is 3306; check the `port=` line in
# C:\xampp\mysql\bin\my.ini if your XAMPP uses a different one.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=telugu_icon_awards

# Interpret DATETIME columns as UTC. Use +05:30 for IST.
DB_TIMEZONE=Z

# Create the database and apply backend/database/schema.sql:
#   cd backend && npm run db:setup

# JWT Secret for admin authentication
JWT_SECRET=telugu_icon_awards_secret_key_2024_very_secure
JWT_EXPIRES_IN=24h

# Frontend origin allowed to access API (* allows any domain, or set to your deployed URL)
FRONTEND_URL=*